    "expo-constants": "~17.0.2",
    "expo-file-system": "~18.0.3",
    "expo-font": "~13.0.2",
    "expo-haptics": "~14.0.2",
    "expo-linking": "~7.0.2",
    "expo-notifications": "~0.29.6",
    "expo-router": "~4.0.2",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.7",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^1.47.0",
    "query-string": "^7.1.3",
